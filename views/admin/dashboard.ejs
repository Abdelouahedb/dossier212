<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord — Admin DOSSIER 212</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .stat-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border); padding: 24px; }
    .stat-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 8px; }
    .stat-number { font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 700; color: var(--text-primary); }
    .dash-table { width: 100%; border-collapse: collapse; }
    .dash-table th { font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); text-align: left; padding: 12px; border-bottom: 1px solid var(--border); }
    .dash-table td { padding: 12px; border-bottom: 1px solid var(--border); font-size: 14px; }
    .dash-table tr:hover td { background: var(--bg-card); }
    .dash-table a { color: inherit; text-decoration: none; font-weight: 600; }
    .dash-table a:hover { color: var(--accent); }
    .badge { display: inline-block; font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 8px; }
    .badge-yes { background: rgba(35,76,35,0.3); color: #7f9f7f; }
    .badge-no { background: var(--bg-secondary); color: var(--text-muted); }
    .action-link { color: var(--accent); text-decoration: none; font-family: 'IBM Plex Mono', monospace; font-size: 12px; }
    .action-link:hover { text-decoration: underline; }
    .btn-new { display: inline-block; background: var(--accent); color: #fff; padding: 10px 20px; font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; transition: background 0.2s; }
    .btn-new:hover { background: var(--accent-hover); text-decoration: none; }
    @media (max-width: 768px) {
      .stat-cards { grid-template-columns: 1fr; }
      .admin-sidebar { display: none; }
      .admin-main { margin-left: 0 !important; }
    }
  </style>
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div style="padding: 20px; font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 600;">
        <a href="/admin" style="color: inherit; text-decoration: none;">DOSSIER <span style="color: var(--accent)">212</span></a>
        <div style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; opacity: 0.5; margin-top: 5px;">ADMINISTRATION</div>
      </div>
      <nav style="display: flex; flex-direction: column; gap: 4px; padding: 0 12px;">
        <a href="/admin" style="color: var(--text-primary); text-decoration: none; padding: 8px 12px; font-size: 14px; border-left: 3px solid var(--accent);">Tableau de bord</a>
        <a href="/admin/dossier/new" style="color: var(--text-secondary); text-decoration: none; padding: 8px 12px; font-size: 14px;">Nouveau dossier</a>
        <a href="/" target="_blank" style="color: var(--text-secondary); text-decoration: none; padding: 8px 12px; font-size: 14px; margin-top: 16px;">Voir le site ↗</a>
        <a href="/admin/logout" style="color: #ff4d4f; text-decoration: none; padding: 8px 12px; font-size: 14px;">Déconnexion</a>
      </nav>
    </aside>

    <main class="admin-main" style="margin-left: 250px; padding: 40px; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <h1>Tableau de bord</h1>
        <a href="/admin/dossier/new" class="btn-new">+ Nouveau dossier</a>
      </div>

      <div class="stat-cards">
        <div class="stat-card">
          <div class="stat-label">Total dossiers</div>
          <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.total : 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Publiés</div>
          <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.published : 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Brouillons</div>
          <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.drafts : 0 %></div>
        </div>
      </div>

      <table class="dash-table">
        <thead>
          <tr>
            <th>N°</th>
            <th>Titre</th>
            <th>Catégorie</th>
            <th>Statut</th>
            <th>Publié</th>
            <th>À la une</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof dossiers !== 'undefined' && dossiers.length > 0) { %>
            <% dossiers.forEach(d => { %>
              <tr>
                <td style="font-family: 'IBM Plex Mono', monospace; font-size: 13px;"><%= String(d.numero).padStart(3, '0') %></td>
                <td><a href="/admin/dossier/<%= d.id %>/edit"><%= d.titre_fr %></a></td>
                <td style="text-transform: uppercase; font-size: 12px;"><%= d.categorie %></td>
                <td><span class="status-badge status-<%= d.statut %>"><%= d.statut ? d.statut.replace(/_/g, ' ').toUpperCase() : '' %></span></td>
                <td><span class="badge <%= d.est_publie ? 'badge-yes' : 'badge-no' %>"><%= d.est_publie ? 'OUI' : 'NON' %></span></td>
                <td><span class="badge <%= d.est_a_la_une ? 'badge-yes' : 'badge-no' %>"><%= d.est_a_la_une ? 'OUI' : 'NON' %></span></td>
                <td>
                  <a href="/admin/dossier/<%= d.id %>/edit" class="action-link">Modifier</a>
                  &nbsp;·&nbsp;
                  <a href="/dossier/<%= d.slug %>" class="action-link" target="_blank">Voir</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">Aucun dossier. <a href="/admin/dossier/new">Créer le premier →</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
